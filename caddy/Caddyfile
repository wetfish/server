# Shared reverse proxy for every project on this server.
#
# Caddy obtains and renews HTTPS certificates automatically and redirects
# HTTP to HTTPS. A certificate can only be issued once a domain's DNS points
# at this server; until then Caddy keeps retrying in the background, and the
# other domains are unaffected.
#
# Files generated on this server are mounted from generated/caddy/ at
# /etc/caddy-generated/. An import that matches no files is not an error, so
# a server with none of them starts normally.
{
	# Server-wide settings generated on this server, such as the trusted
	# proxies of Cloudflare-only mode (see cloudflare.sh)
	import /etc/caddy-generated/global/*.Caddyfile
}

# Serves a project: `import project <container>:<port>`. Responses are
# compressed, and the project receives the visitor's address in X-Real-IP
# (from Cloudflare's CF-Connecting-IP in Cloudflare-only mode).
(project) {
	encode zstd gzip

	reverse_proxy {args[0]} {
		header_up X-Real-IP {client_ip}
	}
}

# Keeps a site out of search results: every staging site, and the server's
# own hostname
(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

# The server's own hostname (SERVER_HOSTNAME in the root .env): receives the
# GitHub push webhooks for every project
{$SERVER_HOSTNAME} {
	import noindex

	# GitHub push webhooks; see webhook/
	handle /hooks/* {
		reverse_proxy shared-webhook:9000
	}

	# Everything else, generated by apply.sh: the project whose domains
	# include this hostname, or a plain "OK" for checking the server is up
	handle {
		import /etc/caddy-generated/hostname/*.Caddyfile
	}
}

# One file per project, generated by apply.sh from config/<project>.conf
import /etc/caddy-generated/sites/*.Caddyfile
