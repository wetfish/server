# Shared reverse proxy for every project on this server.
#
# Caddy obtains and renews HTTPS certificates automatically and redirects
# HTTP to HTTPS. A certificate can only be issued once a domain's DNS points
# at this server; until then Caddy keeps retrying in the background, and the
# other domains are unaffected.
#
# Files generated on this server are mounted from generated/caddy/ at
# /etc/caddy-generated/. An import that matches no files is not an error, so
# a server with none of them starts normally.
{
	# Server-wide settings generated on this server, such as the trusted
	# proxies of Cloudflare-only mode (see cloudflare.sh)
	import /etc/caddy-generated/global/*.Caddyfile
}

# Serves a project: `import project <container>:<port>`. Responses are
# compressed, and the project receives the visitor's address in X-Real-IP
# (from Cloudflare's CF-Connecting-IP in Cloudflare-only mode).
#
# A 502 or 504 the project answers itself, such as nginx finding its PHP
# container unreachable, becomes an error here too, so `import maintenance`
# shows the same page as when the project can't be reached at all.
(project) {
	encode zstd gzip

	reverse_proxy {args[0]} {
		header_up X-Real-IP {client_ip}

		@unavailable status 502 504
		handle_response @unavailable {
			error "Unavailable" {rp.status_code}
		}
	}
}

# Shows a maintenance page instead of a bare 502 or 504 for a project:
# `import maintenance <project>`, in the project's site block. Requests are
# never held or retried, so no visitor reaches a site whose containers are
# being replaced. The page keeps the error's status code.
#
# While deploy.sh replaces the project's containers, it writes
# generated/maintenance/<project>/deploying, and the page says the site is
# being updated; otherwise it says the site is temporarily unavailable. A
# project's own pages, copied from its repository by each deploy, are shown
# instead of the shared ones in caddy/pages/.
(maintenance) {
	handle_errors 502 504 {
		root * /srv/pages
		header Cache-Control "no-store"
		header Retry-After "30"

		@deploying file {
			root /srv/pages
			try_files /projects/{args[0]}/deploying
		}

		handle @deploying {
			try_files /projects/{args[0]}/updating.html /default/updating.html
			file_server
		}

		handle {
			try_files /projects/{args[0]}/unavailable.html /default/unavailable.html
			file_server
		}
	}
}

# Keeps a site out of search results: every staging site, and the server's
# own hostname
(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

# The server's own hostname (SERVER_HOSTNAME in the root .env): receives the
# GitHub push webhooks for every project
{$SERVER_HOSTNAME} {
	import noindex

	# GitHub push webhooks; see webhook/
	handle /hooks/* {
		reverse_proxy shared-webhook:9000
	}

	# Everything else, generated by apply.sh: the project whose domains
	# include this hostname, with its maintenance pages, or a plain "OK" for
	# checking the server is up
	import /etc/caddy-generated/hostname/*.Caddyfile
}

# One file per project, generated by apply.sh from config/<project>.conf
import /etc/caddy-generated/sites/*.Caddyfile
