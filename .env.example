# Server configuration. On a server, setup.sh writes .env from this file;
# to try the shared services locally, copy it to .env yourself. Keep
# comments on their own lines.

# This server's own hostname, for example stage.wetfish.net or
# prod.wetfish.net. It receives the GitHub webhooks for every project at
# https://<SERVER_HOSTNAME>/hooks/<project>. Use localhost to try the shared
# services on your own machine.
SERVER_HOSTNAME=localhost

# User and group IDs the webhook container runs as, so it can write the
# trigger files. setup.sh sets these to the deploy user's IDs; locally, use
# your own (run `id -u` and `id -g`).
UID=1000
GID=1000
