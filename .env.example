# Server configuration: copy to .env. Keep comments on their own lines.

# This server's own hostname, for example stage.wetfish.net or
# prod.wetfish.net. It receives the GitHub webhooks for every project at
# https://<SERVER_HOSTNAME>/hooks/<project>. Use localhost to try the shared
# services on your own machine.
SERVER_HOSTNAME=localhost

# User and group IDs the webhook container runs as. Match the owner of this
# clone (run `id -u` and `id -g`) so it can write the trigger files.
UID=1000
GID=1000
