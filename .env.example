# Server configuration. On a server, setup.sh writes .env from this file;
# to try the shared services locally, copy it to .env yourself. Keep
# comments on their own lines.

# This server's own hostname, for example stage.wetfish.net or
# prod.wetfish.net. It receives the GitHub webhooks for every project at
# https://<SERVER_HOSTNAME>/hooks/<project>. Use localhost to try the shared
# services on your own machine.
SERVER_HOSTNAME=localhost

# staging or production. Staging deploys each project's main branch and keeps
# its sites out of search results; production deploys release. A project can
# deploy another branch with BRANCH= in its config file.
SERVER_ENVIRONMENT=staging

# User and group IDs the webhook container runs as, so it can write the
# trigger files. setup.sh sets these: the deploy user's IDs on a server, or
# your own in a local copy.
UID=1000
GID=1000

# Root password of the shared database, shared-mariadb. setup.sh generates
# it. The database keeps the password it was created with, so changing it
# here later breaks database.sh; set one yourself only before the database
# first starts.
MARIADB_ROOT_PASSWORD=
